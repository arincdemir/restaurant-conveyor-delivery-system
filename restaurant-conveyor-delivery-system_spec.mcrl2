% ==============================================================================
% DATA TYPES
% ==============================================================================
sort
    Meal = struct Doner ;
    TableID = struct Table1 | Table2;
    StationID = struct TableStation(t: TableID) | Kitchen | ConveyorStation;
    OrderID = Nat;
    PlateID = Nat;
    Money = Nat;
    OrderStatus =
        struct InPreparation | ReadyForLoading | OnBelt | Delivered | Collected;
    OrderEntry = struct order(m: Meal, t: TableID, s: OrderStatus);
    OrderStatusInfo =
        struct statusInfo(orderId: OrderID, status: OrderStatus);
    Plate = struct plate(p_id: PlateID, o_id: OrderID, t_id: TableID);
    BoxOccupied = Bool;
	PosOneOccupied = Bool;
    Position = Nat;
    PlateSlot = struct Empty | Occupied(p: Plate);
    GateState = struct Closed | Open;
    PusherState = struct Retracted | Extending | Extended | Retracting;
    ConveyorState = struct Stopped | Moving;
    SystemMode = struct Normal | Emergency;

% ==============================================================================
% MAPS & EQUATIONS
% ==============================================================================
map
    maxOrders: Nat;
    valid_position: Nat -> Bool;
    setSlot: List(PlateSlot) # Position # PlateSlot -> List(PlateSlot);
    boxes: TableID -> PlateSlot;
    price: Meal -> Money;
    bill: TableID -> Money;
    statusesForTable:
        (OrderID -> OrderEntry) # FSet(OrderID) # TableID
        -> FSet(OrderStatusInfo);
	%orders: OrderID -> OrderEntry;

var
    pos: Position;
    om: OrderID -> OrderEntry;
    ids: FSet(OrderID);
    table: TableID;
    rest: List(PlateSlot);
    firstSlot, newSlot: PlateSlot;

eqn
    maxOrders = 3;
    valid_position(pos) = (pos <= 5);

    % Change one slot without changing the rest of the belt.
    setSlot([], pos, newSlot) = [];
    setSlot(firstSlot |> rest, 0, newSlot) = newSlot |> rest;
    pos > 0 -> setSlot(firstSlot |> rest, pos, newSlot) =
        firstSlot |> setSlot(rest, Int2Nat(pos - 1), newSlot);

    statusesForTable(om, {}, table) = {};

    ids != {} ->
      statusesForTable(om, ids, table) =
        if(t(om(pick(ids))) == table,
           {statusInfo(pick(ids), s(om(pick(ids))))}
             + statusesForTable(om, ids - {pick(ids)}, table),
           statusesForTable(om, ids - {pick(ids)}, table));

% ==============================================================================
% ACTIONS
% ==============================================================================
act
    % External actions
    AcceptOrder: Meal # TableID;
    DisplayStatus: TableID # FSet(OrderStatusInfo);
    CalculateBill: TableID;
    AddPlate: OrderID # TableID;
    LoadPlate: PlateID;
    StopLoading;
    StartEmergency;
    OperatorClearEmergency;
    EndEmergency;
    Advance: Position;
	%New action
	StartConveyor;
    StopConveyor;
    OpenInnerGate: TableID;
    OpenOuterGate: TableID;
    CloseInnerGate: TableID;
    CloseOuterGate: TableID;
    Push: TableID;
    Retract: TableID;
    ConveyorMovedNewPosition: TableID # PlateSlot;
    ConveyorPosition: TableID # PlateSlot;

    % Internal actions
    SendOrder: OrderID # OrderEntry;
    ReceiveOrder: OrderID # OrderEntry;
	OrderToKitchen: OrderID # OrderEntry;
    CheckPosOne;
    ReportSkip;
    IssueEmergency, ReceivesEmergency, EmergencyReceived: StationID;
    IssueClearEmergency, ReceivesClearEmergency, EmergencyCleared: StationID;
    RequestPermission;
    CheckPlate: PlateID # TableID;
    BoxEmptied: TableID;
    BoxFilled: TableID;
    SendSkip: StationID;
    ScanID: PlateID;
    ReceivesConveyorPosition: TableID # PlateSlot;
    RequestRound, PermitRound, RoundPermitted;
    SendLoadingPosition, ReceivesLoadingPosition, LoadingPosition: PlateSlot;
    OffersLoadingPlate, ReceivesLoadingPlate, PlateLoaded: Plate;
    OffersTransfer, ReceivesTransfer, PlateTransferred: TableID # Plate;
    SendStationDone, ReceivesStationDone, StationDone: StationID;


% ==============================================================================
% PROCESSES & INITIALISATION
% ==============================================================================
proc
    OrderManager(
        orders: OrderID -> OrderEntry,
        existing: FSet(OrderID),
        nextID: OrderID,
        mode: SystemMode,
        emergencySent: Bool,
        operatorCleared: Bool,
        pending: FSet(OrderID)
    ) =
        % Accept at most maxOrders orders (IDs 0 to maxOrders - 1).
        (mode == Normal && nextID < maxOrders) -> (sum meal: Meal, tbl: TableID .
            AcceptOrder(meal, tbl) .
            OrderManager(
                orders[nextID -> order(meal, tbl, InPreparation)],
                existing + {nextID},
                nextID + 1,
                mode,
                emergencySent,
                operatorCleared,
                pending + {nextID}
            ))

      % Dispatch separately so acceptance does not wait for a busy kitchen.
      + sum oid: OrderID .
            (oid < maxOrders && oid in pending &&
             !(exists earlier: OrderID . earlier < oid && earlier in pending)) ->
                SendOrder(oid, orders(oid)) .
                OrderManager(pending = pending - {oid})

      + (mode == Normal) -> PermitRound . OrderManager()

      + sum id: OrderID .
            (id in existing) ->
                CalculateBill(t(orders(id))) .
                OrderManager()

      + sum tbl: TableID .
            DisplayStatus(tbl, statusesForTable(orders, existing, tbl)) .
            OrderManager()

      % Record the request immediately. table notification is deferred. probably need to change this later on
      % But then, we will need to allow the emergency notification between every action sequence. right now, table controller doesn't do that.
      + (mode == Normal) ->
            StartEmergency .
            OrderManager(mode = Emergency, emergencySent = false, operatorCleared = false)

      % Doing the notification later allows the tables to go to their main state to accept the emergency.
      + (mode == Emergency && !emergencySent) ->
            (IssueEmergency(ConveyorStation) |
             IssueEmergency(Kitchen) |
             IssueEmergency(TableStation(Table1)) |
             IssueEmergency(TableStation(Table2))) .
            OrderManager(emergencySent = true)

      + (mode == Emergency && emergencySent && !operatorCleared) ->
            OperatorClearEmergency .
            OrderManager(operatorCleared = true)

      % Again, give time for the tables to go into the clean state so the emergency can be cleared.
      + (mode == Emergency && emergencySent && operatorCleared) ->
            (EndEmergency |
             IssueClearEmergency(ConveyorStation) |
             IssueClearEmergency(Kitchen) |
             IssueClearEmergency(TableStation(Table1)) |
             IssueClearEmergency(TableStation(Table2))) .
            OrderManager(mode = Normal, emergencySent = false, operatorCleared = false);

	
    ConveyorBelt(
        pos: Position, mode: SystemMode, belt: List(PlateSlot),
        pending: FSet(StationID), servicing: Bool
    ) =
        % Six-slot belt: kitchen at 0, tables at 2 and 4.
        % Give all stations their current slot while the belt is stopped.
        % pos starts at 0 and wraps at 5, so its range is preserved.
        (mode == Normal && !servicing) ->
            (RequestPermission | RequestRound |
             SendLoadingPosition(belt . 0) |
             ConveyorMovedNewPosition(Table1, belt . 2) |
             ConveyorMovedNewPosition(Table2, belt . 4)) .
            ConveyorBelt(pending = {Kitchen, TableStation(Table1), TableStation(Table2)},
                         servicing = true)

      % Load into slot 0. Belt updates are handled one at a time.
      + sum pid: PlateID, tbl: TableID .
            (mode == Normal && servicing && Kitchen in pending &&
             belt . 0 == Empty && pid < maxOrders) ->
                ReceivesLoadingPlate(plate(pid, pid, tbl)) .
                ConveyorBelt(belt = setSlot(belt, 0, Occupied(plate(pid, pid, tbl))))

      % A push removes exactly the matching plate at that table's location.
      + sum pid: PlateID, tbl: TableID .
            (mode == Normal && servicing && TableStation(tbl) in pending &&
             pid < maxOrders && belt . if(tbl == Table1, 2, 4) == Occupied(plate(pid, pid, tbl))) ->
                ReceivesTransfer(tbl, plate(pid, pid, tbl)) .
                ConveyorBelt(belt = setSlot(belt, if(tbl == Table1, 2, 4), Empty))

      + sum st: StationID .
            (mode == Normal && servicing && st in pending) ->
                ReceivesStationDone(st) . ConveyorBelt(pending = pending - {st})

      % All stations are done; rotate slot 5 to 0 and the other slots forward.
      + (mode == Normal && servicing && pending == {}) ->
            StartConveyor . Advance(pos) . StopConveyor .
            ConveyorBelt(pos = if(pos == 5, 0, pos + 1),
                         belt = rhead(belt) |> rtail(belt), servicing = false)

      + (mode == Normal && (!servicing || pending == {})) ->
            ReceivesEmergency(ConveyorStation) . StopConveyor .
            ConveyorBelt(mode = Emergency, pending = {}, servicing = false)

      + (mode == Emergency) ->
            ReceivesClearEmergency(ConveyorStation) . ConveyorBelt(mode = Normal);
       
    DeliveryBox(
        tableID: TableID,
        innerGateState: GateState,
        outerGateState: GateState,
        boxOccupied: BoxOccupied,
        mode: SystemMode,
        boxPlate: Plate
    ) =
        (mode == Normal) -> (sum inSlot: PlateSlot .
            ReceivesConveyorPosition(tableID, inSlot) .
            (inSlot == Empty ||
             t_id(p(inSlot)) != tableID ||
             boxOccupied == true ||
             outerGateState == Open) ->
            ((innerGateState == Open) ->
                CloseInnerGate(tableID) . SendSkip(TableStation(tableID)) .
                SendStationDone(TableStation(tableID)) .
                DeliveryBox(innerGateState = Closed)
             <>
                SendSkip(TableStation(tableID)) .
                SendStationDone(TableStation(tableID)) . DeliveryBox())
            <>
            ((innerGateState == Closed) ->
                OpenInnerGate(tableID) . DeliverPlate(tableID, p(inSlot))
             <>
                DeliverPlate(tableID, p(inSlot))))
        + (mode == Normal && boxOccupied && outerGateState == Open) ->
            BoxEmptied(tableID) .
            CloseOuterGate(tableID) .
            DeliveryBox(innerGateState = Closed, outerGateState = Closed, boxOccupied = false)

        + (mode == Normal) ->
            ReceivesEmergency(TableStation(tableID)) .
            DeliveryBox(mode = Emergency)

        + (mode == Emergency && innerGateState == Open) ->
            CloseInnerGate(tableID) .
            DeliveryBox(innerGateState = Closed)

        + (mode == Emergency && innerGateState == Closed && outerGateState == Closed) ->
            OpenOuterGate(tableID) .
            DeliveryBox(outerGateState = Open)

        + (mode == Emergency && innerGateState == Closed && outerGateState == Open && boxOccupied) ->
            BoxEmptied(tableID) .
            DeliveryBox(boxOccupied = false)

        + (mode == Emergency && innerGateState == Closed && outerGateState == Open) ->
            ReceivesClearEmergency(TableStation(tableID)) .
            (boxOccupied ->
                DeliveryBox(mode = Normal)
             <>
                CloseOuterGate(tableID) .
                OpenInnerGate(tableID) .
                DeliveryBox(innerGateState = Open, outerGateState = Closed, mode = Normal));

    % The shared delivery sequence retains the plate received from the belt.
    DeliverPlate(tableID: TableID, incoming: Plate) =
        (Push(tableID) | BoxFilled(tableID) | OffersTransfer(tableID, incoming)) .
        Retract(tableID) . CloseInnerGate(tableID) . OpenOuterGate(tableID) .
        SendStationDone(TableStation(tableID)) .
        DeliveryBox(tableID, Closed, Open, true, Normal, incoming);

	KitchenLoader(
		orders: OrderID -> OrderEntry,
		unassigned: FSet(OrderID),
		posOneOccupied: PosOneOccupied,
		skipped: Bool,
        mode: SystemMode
	) =
		sum oid: OrderID, entry: OrderEntry .
                (oid < maxOrders) ->
				ReceiveOrder(oid, entry) .
				KitchenLoader(
					orders[oid -> entry],
					unassigned + {oid},
					posOneOccupied,
					skipped,
                    mode
				)
		+
        (mode == Normal && skipped) -> (sum inSlot: PlateSlot .
            ReceivesLoadingPosition(inSlot) . CheckPosOne .
            KitchenLoader(posOneOccupied = inSlot != Empty, skipped = false))
        +
		(mode == Normal && !skipped && (posOneOccupied || unassigned == {})) ->
			SendSkip(Kitchen) . SendStationDone(Kitchen) .
			KitchenLoader(skipped = true)
		+
		sum oid: OrderID, pid: PlateID .
			(mode == Normal && oid in unassigned && !posOneOccupied &&
             !skipped && pid < maxOrders && pid == oid) ->
			AddPlate(oid, t(orders(oid))) .
			(LoadPlate(pid) | OffersLoadingPlate(plate(pid, oid, t(orders(oid))))) .
            SendStationDone(Kitchen) .
			KitchenLoader(orders, unassigned - {oid}, posOneOccupied, true, mode)
        + (mode == Normal && skipped) ->
            ReceivesEmergency(Kitchen) . StopLoading . KitchenLoader(mode = Emergency)
        + (mode == Emergency) ->
            ReceivesClearEmergency(Kitchen) . KitchenLoader(mode = Normal)
	;

    System =
        % Block unmatched sends/receives, only their communication may occur.
        block({ConveyorMovedNewPosition, ReceivesConveyorPosition, SendOrder, ReceiveOrder, IssueEmergency, ReceivesEmergency,
        IssueClearEmergency, ReceivesClearEmergency,
        RequestRound, PermitRound, SendLoadingPosition, ReceivesLoadingPosition,
        OffersLoadingPlate, ReceivesLoadingPlate, OffersTransfer, ReceivesTransfer,
        SendStationDone, ReceivesStationDone},
            comm(
				{
					ConveyorMovedNewPosition | ReceivesConveyorPosition
						-> ConveyorPosition,
                    IssueEmergency | ReceivesEmergency
                        -> EmergencyReceived,
                    IssueClearEmergency | ReceivesClearEmergency
                        -> EmergencyCleared,
                    RequestRound | PermitRound -> RoundPermitted,
                    SendLoadingPosition | ReceivesLoadingPosition -> LoadingPosition,
                    OffersLoadingPlate | ReceivesLoadingPlate -> PlateLoaded,
                    OffersTransfer | ReceivesTransfer -> PlateTransferred,
                    SendStationDone | ReceivesStationDone -> StationDone,
					SendOrder | ReceiveOrder
						-> OrderToKitchen
				},
                OrderManager(
                    lambda id: OrderID . order(Doner, Table1, InPreparation),
                    {},
                    0,
                    Normal,
                    false,
                    false,
                    {}
                )
                || ConveyorBelt(0, Normal,
                    [Empty, Empty, Empty, Empty, Empty, Empty],
                    {}, false)
				|| KitchenLoader(
					lambda oid: OrderID . order(Doner, Table1, InPreparation),
					{},
					false,
					true,
                    Normal
				)
                || DeliveryBox(Table1, Open, Closed, false, Normal, plate(0, 0, Table1))
                || DeliveryBox(Table2, Open, Closed, false, Normal, plate(0, 0, Table2))
            )
        );

% Interleave independent actions, retaining the required synchronized actions.
% The controllers still run in parallel and may act in either order.
init allow({
    AcceptOrder, DisplayStatus, CalculateBill, AddPlate, StopLoading,
    StartEmergency, OperatorClearEmergency,
    StartConveyor, Advance, StopConveyor,
    OpenInnerGate, CloseInnerGate, OpenOuterGate, CloseOuterGate,
    Retract, OrderToKitchen, CheckPosOne, BoxEmptied, SendSkip, StationDone,
    LoadPlate | PlateLoaded,
    Push | BoxFilled | PlateTransferred,
    RequestPermission | RoundPermitted | LoadingPosition |
        ConveyorPosition | ConveyorPosition,
    EmergencyReceived | EmergencyReceived |
        EmergencyReceived | EmergencyReceived,
    EndEmergency | EmergencyCleared | EmergencyCleared |
        EmergencyCleared | EmergencyCleared
}, System);

