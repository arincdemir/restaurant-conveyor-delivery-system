% ==============================================================================
% DATA TYPES
% ==============================================================================
sort
    Meal = struct Doner | Souvlaki | Skyr | Biryani;
    TableID = struct Table1 | Table2;
    StationID = struct TableStation(t: TableID) | Kitchen;
    OrderID = Nat;
    PlateID = Nat;
    Money = Nat;
    OrderStatus =
        struct InPreparation | ReadyForLoading | OnBelt | Delivered | Collected;
    OrderEntry = struct order(m: Meal, t: TableID, s: OrderStatus);
    OrderStatusInfo =
        struct statusInfo(orderId: OrderID, status: OrderStatus);
    Plate = struct plate(p_id: PlateID, o_id: OrderID, t_id: TableID);
    BoxOccupied = Bool;
	PosOneOccupied = Bool;
    Position = Nat;
    PlateSlot = struct Empty | Occupied(p: Plate);
    GateState = struct Closed | Open;
    PusherState = struct Retracted | Extending | Extended | Retracting;
    ConveyorState = struct Stopped | Moving;
    SystemMode = struct Normal | Emergency;

% ==============================================================================
% MAPS & EQUATIONS
% ==============================================================================
map
    valid_position: Nat -> Bool;
    belt: Position -> PlateSlot;
    boxes: TableID -> PlateSlot;
    price: Meal -> Money;
    bill: TableID -> Money;
    statusesForTable:
        (OrderID -> OrderEntry) # FSet(OrderID) # TableID
        -> FSet(OrderStatusInfo);
	%orders: OrderID -> OrderEntry;

var
    pos: Position;
    om: OrderID -> OrderEntry;
    ids: FSet(OrderID);
    table: TableID;

eqn
    valid_position(pos) = (pos <= 9);

    statusesForTable(om, {}, table) = {};

    ids != {} ->
      statusesForTable(om, ids, table) =
        if(t(om(pick(ids))) == table,
           {statusInfo(pick(ids), s(om(pick(ids))))}
             + statusesForTable(om, ids - {pick(ids)}, table),
           statusesForTable(om, ids - {pick(ids)}, table));

% ==============================================================================
% ACTIONS
% ==============================================================================
act
    % External actions
    AcceptOrder: Meal # TableID;
    DisplayStatus: TableID # FSet(OrderStatusInfo);
    CalculateBill: TableID;
    AddPlate: OrderID # TableID;
    LoadPlate: PlateID;
    StopLoading;
    StartEmergency;
    EndEmergency;
    Advance: Position;
    StopConveyor;
    OpenInnerGate: TableID;
    OpenOuterGate: TableID;
    CloseInnerGate: TableID;
    CloseOuterGate: TableID;
    Push;
    Retract;
    ConveyorMovedNewPosition: TableID # PlateSlot;
    ConveyorPosition: TableID # PlateSlot;

    % Internal actions
    SendOrder: OrderID # OrderEntry;
    ReceiveOrder: OrderID # OrderEntry;
	OrderToKitchen: OrderID # OrderEntry;
    CheckPosOne;
    ReportSkip;
    IssueEmergency;
    IssueClearEmergency;
    RequestPermission;
    ReceivesEmergency;
    ReceivesClearEmergency;
    CheckPlate: PlateID # TableID;
    BoxEmptied: TableID;
    BoxFilled: TableID;
    SendSkip: StationID;
    ScanID: PlateID;
    ReceivesConveyorPosition: TableID # PlateSlot;


% ==============================================================================
% PROCESSES & INITIALISATION
% ==============================================================================
proc
    OrderManager(
        orders: OrderID -> OrderEntry,
        existing: FSet(OrderID),
        nextID: OrderID
    ) =
        % Accept at most two orders (IDs 0 and 1).
        (nextID < 2) -> (sum meal: Meal, tbl: TableID .
            AcceptOrder(meal, tbl) .
			SendOrder(nextID, order(meal, tbl, InPreparation)) . % Send order to KitchenLoader
            OrderManager(
                orders[nextID -> order(meal, tbl, InPreparation)],
                existing + {nextID},
                nextID + 1
            ))

      + sum id: OrderID .
            (id in existing) ->
                CalculateBill(t(orders(id))) .
                OrderManager(orders, existing, nextID)

      + sum tbl: TableID .
            DisplayStatus(tbl, statusesForTable(orders, existing, tbl)) .
            OrderManager(orders, existing, nextID);

    % Minimal test belt: repeatedly present one fixed plate to Table1.
    ConveyorBelt =
        ConveyorMovedNewPosition(Table1, Occupied(plate(0, 0, Table1))) .
        ConveyorBelt;

    DeliveryBox(tableID: TableID, innerGateState: GateState, outerGateState: GateState, boxOccupied: BoxOccupied) = 
        sum inSlot: PlateSlot .
            ReceivesConveyorPosition(tableID, inSlot) .
            (inSlot == Empty ||
             t_id(p(inSlot)) != tableID ||
             boxOccupied == true ||
             innerGateState == Closed ||
             outerGateState == Open) ->
            SendSkip(TableStation(tableID)) .
            DeliveryBox(tableID, innerGateState, outerGateState, boxOccupied) <>
            Push . 
            BoxFilled(tableID) .
            CloseInnerGate(tableID) .
            OpenOuterGate(tableID) .
            DeliveryBox(tableID, Closed, Open, true)
        + (boxOccupied && outerGateState == Open) ->
            BoxEmptied(tableID) .
            CloseOuterGate(tableID) .
            OpenInnerGate(tableID) .
            DeliveryBox(tableID, Open, Closed, false)
    ;

	KitchenLoader(
		orders: OrderID -> OrderEntry,
		unassigned: FSet(OrderID),
		posOneOccupied: PosOneOccupied,
		skipped: Bool
	) =
		sum oid: OrderID, entry: OrderEntry .
			(oid < 2) ->
				ReceiveOrder(oid, entry) .
				KitchenLoader(
					orders[oid -> entry],
					unassigned + {oid},
					posOneOccupied,
					skipped
				)
		+
		(!skipped && (posOneOccupied || unassigned == {})) ->
			SendSkip(Kitchen) .
			KitchenLoader(orders, unassigned, posOneOccupied, true) 
		+
		sum oid: OrderID, pid: PlateID .
			(oid in unassigned && !posOneOccupied && pid < 2) ->
			AddPlate(pid, t(orders(oid))) .
			LoadPlate(pid) .
			SendSkip(Kitchen) .
			KitchenLoader(orders, unassigned - {oid}, posOneOccupied, true)
	;


    System =
        % Block unmatched sends/receives, only their communication may occur.
        block({ConveyorMovedNewPosition, ReceivesConveyorPosition, SendOrder, ReceiveOrder},
            comm(
				{
					ConveyorMovedNewPosition | ReceivesConveyorPosition
						-> ConveyorPosition,
					SendOrder | ReceiveOrder
						-> OrderToKitchen
				},
                OrderManager(
                    lambda id: OrderID . order(Doner, Table1, InPreparation),
                    {},
                    0
                )
                || ConveyorBelt
				|| KitchenLoader(
					lambda oid: OrderID . order(Doner, Table1, InPreparation),
					{},
					false,
					false
				)
                || DeliveryBox(Table1, Open, Closed, false)
                || DeliveryBox(Table2, Open, Closed, false)
            )
        );

init System;

