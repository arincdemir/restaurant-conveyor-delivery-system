% ==============================================================================
% DATA TYPES
% ==============================================================================
sort 
	Meal = struct Doner | Souvlaki | Skyr | Biryani;
	TableID = struct Table1 | Table2;
	OrderID = Nat;
	PlateID = Nat;
	Money = Nat;
	OrderStatus = struct InPreparation | ReadyForLoading | OnBelt | Delivered | Collected;
	OrderEntry = struct order(m: Meal, t: TableID, s: OrderStatus);
	Plate = struct plate(p_id: PlateID, o_id: OrderID, t_id: TableID);
	Position = Nat;
	PlateSlot = struct Empty | Occupied(p: Plate);
	GateState = struct Closed | Opening | Open | Closing;
	PusherState = struct Retracted | Extending | Extended | Retracting;
	ConveyorState = struct Stopped | Moving;
	SystemMode = struct Normal | Emergency;

% ==============================================================================
% MAPS & EQUATIONS
% ==============================================================================
map
	valid_position: Nat -> Bool;
	belt: Position -> PlateSlot;
	boxes: TableID -> PlateSlot;
	price: Meal -> Money;
	bill: TableID -> Money;
	orders: OrderID -> OrderEntry;

% Explicit variable declaration required for equations
var 
	p: Position;

eqn
	valid_position(p) = (p <= 9);

% ==============================================================================
% ACTIONS
% ==============================================================================
act
	% External actions
	AcceptOrder : Meal # TableID;
	DisplayStatus : TableID;
	CalculateBill : TableID;
	AddPlate : OrderID # TableID;
	LoadPlate : PlateID;
	StopLoading;
	StartEmergency;
	EndEmergency;
	Advance : Position;
	StopConveyor;
	OpenInnerGate;
	OpenOuterGate;
	CloseInnerGate;
	CloseOuterGate;
	Push;
	Retract;

	% Internal actions
	SendOrder : Meal # TableID;
	ReceivesOrder : Meal # TableID;
	CheckPosOne;
	ReportSkip;
	IssueEmergency;
	IssueClearEmergency;
	RequestPermission;
	ReceivesEmergency;
	ReceivesClearEmergency;
	CheckPlate : PlateID # TableID;
	CheckEmptyBox : TableID;
	SendSkip;
	ScanID : PlateID;

% ==============================================================================
% PROCESSES & INITIALISATION
% ==============================================================================
proc 
	System = tau;

init 
	System;