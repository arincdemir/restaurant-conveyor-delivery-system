% ==============================================================================
% DATA TYPES
% ==============================================================================
sort
    Meal = struct Doner;
    TableID = struct Table1 | Table2;
    StationID = struct TableStation(t: TableID) | Kitchen | ConveyorStation;
    OrderID = Nat;
    OrderEntry = struct order(m: Meal, t: TableID);
    Plate = struct plate(o_id: OrderID, t_id: TableID);
    BoxOccupied = Bool;
    PosOneOccupied = Bool;
    Position = Nat;
    PlateSlot = struct Empty | Occupied(p: Plate);
    GateState = struct Closed | Open;
    SystemMode = struct Normal | Emergency;

% ==============================================================================
% MAPS & EQUATIONS
% ==============================================================================
map
    maxOrders: Nat;
    setSlot: List(PlateSlot) # Position # PlateSlot -> List(PlateSlot);

var
    pos: Position;
    rest: List(PlateSlot);
    firstSlot, newSlot: PlateSlot;

eqn
    maxOrders = 3;

    % Change one slot without changing the rest of the belt.
    setSlot([], pos, newSlot) = [];
    setSlot(firstSlot |> rest, 0, newSlot) = newSlot |> rest;
    pos > 0 -> setSlot(firstSlot |> rest, pos, newSlot) =
        firstSlot |> setSlot(rest, Int2Nat(pos - 1), newSlot);

% ==============================================================================
% ACTIONS
% ==============================================================================
act
    % Order manager
    AcceptOrder: Meal # TableID; % Accept a new order for a table.
    SendOrder: OrderID # OrderEntry; % Send an accepted order to the kitchen.
    PermitRound; % Accept the conveyor's request for a servicing round.
    StartEmergency; % Record an emergency request and pause order acceptance.
    IssueEmergency: StationID; % Notify an addressed controller of the emergency.
    OperatorClearEmergency; % Record operator clearance after notification.
    IssueClearEmergency: StationID; % Request reset from an addressed controller.
    EndEmergency; % Resume normal mode together with all controller resets.

    % Conveyor
    RequestPermission; % Announce a request to begin a stopped servicing round.
    RequestRound; % Ask the order manager to authorize the round.
    SendLoadingPosition: PlateSlot; % Send the kitchen the contents of slot 0.
    ConveyorMovedNewPosition: TableID # PlateSlot; % Send a table its aligned slot.
    ReceivesLoadingPlate: Plate; % Accept a plate for insertion into empty slot 0.
    ReceivesTransfer: TableID # Plate; % Accept removal of a matching table's plate.
    ReceivesStationDone: StationID; % Accept a station's completion report.
    StartConveyor; % Begin movement after all stations have finished.
    Advance: Position; % Advance the belt, reporting the modulo-six counter.
    StopConveyor; % Stop movement, including when emergency notification arrives.

    % Kitchen loader
    ReceiveOrder: OrderID # OrderEntry; % Receive and queue an order from the manager.
    ReceivesLoadingPosition: PlateSlot; % Receive the current loading-slot contents.
    CheckPosOne; % Check the loading slot using the received snapshot.
    AddPlate: OrderID # TableID; % Mark an order's plate as prepared.
    LoadPlate: OrderID; % Load the plate identified by its order ID.
    OffersLoadingPlate: Plate; % Offer the prepared plate to the conveyor.
    StopLoading; % Stop loading after emergency notification.

    % Table controllers
    ReceivesConveyorPosition: TableID # PlateSlot; % Receive the table's aligned slot.
    OpenInnerGate: TableID; % Open the gate between the belt and delivery box.
    CloseInnerGate: TableID; % Close the gate between the belt and delivery box.
    OpenOuterGate: TableID; % Open the gate between the box and customer.
    CloseOuterGate: TableID; % Close the gate between the box and customer.
    Push: TableID; % Push a matching plate from the belt into the box.
    Retract: TableID; % Retract the pusher before closing the inner gate.
    BoxFilled: TableID; % Mark the box occupied as part of the atomic transfer.
    BoxEmptied: TableID; % Collect the plate through the open outer gate.
    OffersTransfer: TableID # Plate; % Offer the matching plate's removal from the belt.

    % Shared coordination
    SendSkip: StationID; % Report that a station skips its current round.
    SendStationDone: StationID; % Report that a station has finished the round.
    ReceivesEmergency: StationID; % Receive notification at the controller's address.
    ReceivesClearEmergency: StationID; % Accept reset after controller recovery.

    % Communication results
    OrderToKitchen: OrderID # OrderEntry; % Synchronized order dispatch and receipt.
    RoundPermitted; % Synchronized round request and manager permission.
    LoadingPosition: PlateSlot; % Synchronized loading-slot snapshot delivery.
    ConveyorPosition: TableID # PlateSlot; % Synchronized table-slot snapshot delivery.
    PlateLoaded: Plate; % Synchronized loading and insertion into the belt.
    PlateTransferred: TableID # Plate; % Synchronized box transfer and belt removal.
    StationDone: StationID; % Synchronized station report and conveyor receipt.
    EmergencyReceived: StationID; % Synchronized addressed emergency notification.
    EmergencyCleared: StationID; % Synchronized addressed controller reset.

% ==============================================================================
% PROCESSES & INITIALISATION
% ==============================================================================
proc
    OrderManager(
        orders: OrderID -> OrderEntry,
        nextID: OrderID,
        mode: SystemMode,
        emergencySent: Bool,
        operatorCleared: Bool,
        pending: FSet(OrderID)
    ) =
        % Accept at most maxOrders orders (IDs 0 to maxOrders - 1).
        (mode == Normal && nextID < maxOrders) ->
            (sum meal: Meal, tbl: TableID .
                AcceptOrder(meal, tbl) .
                OrderManager(
                    orders[nextID -> order(meal, tbl)],
                    nextID + 1,
                    mode,
                    emergencySent,
                    operatorCleared,
                    pending + {nextID}
                ))

        % Dispatch separately so acceptance does not wait for a busy kitchen.
        + sum oid: OrderID .
            (oid < maxOrders && oid in pending &&
             !(exists earlier: OrderID . earlier < oid && earlier in pending)) ->
                SendOrder(oid, orders(oid)) .
                OrderManager(pending = pending - {oid})

        + (mode == Normal) ->
            PermitRound . OrderManager()

        % Record the request immediately; active station sequences finish first.
        + (mode == Normal) ->
            StartEmergency .
            OrderManager(mode = Emergency, emergencySent = false, operatorCleared = false)

        % Notify all four controllers together once they can receive.
        + (mode == Emergency && !emergencySent) ->
            (IssueEmergency(ConveyorStation) |
             IssueEmergency(Kitchen) |
             IssueEmergency(TableStation(Table1)) |
             IssueEmergency(TableStation(Table2))) .
            OrderManager(emergencySent = true)

        + (mode == Emergency && emergencySent && !operatorCleared) ->
            OperatorClearEmergency .
            OrderManager(operatorCleared = true)

        % Reset requires operator clearance and all four recovery receivers.
        + (mode == Emergency && emergencySent && operatorCleared) ->
            (EndEmergency |
             IssueClearEmergency(ConveyorStation) |
             IssueClearEmergency(Kitchen) |
             IssueClearEmergency(TableStation(Table1)) |
             IssueClearEmergency(TableStation(Table2))) .
            OrderManager(mode = Normal, emergencySent = false, operatorCleared = false);

    ConveyorBelt(
        pos: Position,
        mode: SystemMode,
        belt: List(PlateSlot),
        pending: FSet(StationID),
        servicing: Bool
    ) =
        % Six-slot belt: kitchen at 0, tables at 2 and 4.
        % Give all stations their current slot while the belt is stopped.
        (mode == Normal && !servicing) ->
            (RequestPermission | RequestRound |
             SendLoadingPosition(belt . 0) |
             ConveyorMovedNewPosition(Table1, belt . 2) |
             ConveyorMovedNewPosition(Table2, belt . 4)) .
            ConveyorBelt(
                pending = {Kitchen, TableStation(Table1), TableStation(Table2)},
                servicing = true
            )

        % Load into slot 0. Belt updates are handled one at a time.
        + sum oid: OrderID, tbl: TableID .
            (mode == Normal && servicing && Kitchen in pending &&
             belt . 0 == Empty && oid < maxOrders) ->
                ReceivesLoadingPlate(plate(oid, tbl)) .
                ConveyorBelt(belt = setSlot(belt, 0, Occupied(plate(oid, tbl))))

        % A push removes exactly the matching plate at that table's location.
        + sum oid: OrderID, tbl: TableID .
            (mode == Normal && servicing && TableStation(tbl) in pending &&
             oid < maxOrders &&
             belt . if(tbl == Table1, 2, 4) == Occupied(plate(oid, tbl))) ->
                ReceivesTransfer(tbl, plate(oid, tbl)) .
                ConveyorBelt(belt = setSlot(belt, if(tbl == Table1, 2, 4), Empty))

        + sum st: StationID .
            (mode == Normal && servicing && st in pending) ->
                ReceivesStationDone(st) .
                ConveyorBelt(pending = pending - {st})

        % Rotate slot 5 to 0 after all reports; wrap the counter modulo six.
        + (mode == Normal && servicing && pending == {}) ->
            StartConveyor . Advance(pos) . StopConveyor .
            ConveyorBelt(
                pos = if(pos == 5, 0, pos + 1),
                belt = rhead(belt) |> rtail(belt),
                servicing = false
            )

        + (mode == Normal && (!servicing || pending == {})) ->
            ReceivesEmergency(ConveyorStation) . StopConveyor .
            ConveyorBelt(mode = Emergency, pending = {}, servicing = false)

        + (mode == Emergency) ->
            ReceivesClearEmergency(ConveyorStation) .
            ConveyorBelt(mode = Normal);

    DeliveryBox(
        tableID: TableID,
        innerGateState: GateState,
        outerGateState: GateState,
        boxOccupied: BoxOccupied,
        mode: SystemMode
    ) =
        (mode == Normal) ->
            (sum inSlot: PlateSlot .
                ReceivesConveyorPosition(tableID, inSlot) .
                (inSlot == Empty ||
                 t_id(p(inSlot)) != tableID ||
                 boxOccupied == true ||
                 outerGateState == Open) ->
                    ((innerGateState == Open) ->
                        CloseInnerGate(tableID) .
                        SendSkip(TableStation(tableID)) .
                        SendStationDone(TableStation(tableID)) .
                        DeliveryBox(innerGateState = Closed)
                     <>
                        SendSkip(TableStation(tableID)) .
                        SendStationDone(TableStation(tableID)) .
                        DeliveryBox())
                 <>
                    ((innerGateState == Closed) ->
                        OpenInnerGate(tableID) . DeliverPlate(tableID, p(inSlot))
                     <>
                        DeliverPlate(tableID, p(inSlot))))

        + (mode == Normal && boxOccupied && outerGateState == Open) ->
            BoxEmptied(tableID) . CloseOuterGate(tableID) .
            DeliveryBox(innerGateState = Closed, outerGateState = Closed, boxOccupied = false)

        + (mode == Normal) ->
            ReceivesEmergency(TableStation(tableID)) .
            DeliveryBox(mode = Emergency)

        + (mode == Emergency && innerGateState == Open) ->
            CloseInnerGate(tableID) .
            DeliveryBox(innerGateState = Closed)

        + (mode == Emergency && innerGateState == Closed && outerGateState == Closed) ->
            OpenOuterGate(tableID) .
            DeliveryBox(outerGateState = Open)

        + (mode == Emergency && innerGateState == Closed && outerGateState == Open && boxOccupied) ->
            BoxEmptied(tableID) .
            DeliveryBox(boxOccupied = false)

        + (mode == Emergency && innerGateState == Closed && outerGateState == Open) ->
            ReceivesClearEmergency(TableStation(tableID)) .
            (boxOccupied ->
                DeliveryBox(mode = Normal)
             <>
                CloseOuterGate(tableID) . OpenInnerGate(tableID) .
                DeliveryBox(innerGateState = Open, outerGateState = Closed, mode = Normal));

    % Keep the incoming plate until the atomic transfer removes it from the belt.
    DeliverPlate(tableID: TableID, incoming: Plate) =
        (Push(tableID) | BoxFilled(tableID) | OffersTransfer(tableID, incoming)) .
        Retract(tableID) . CloseInnerGate(tableID) . OpenOuterGate(tableID) .
        SendStationDone(TableStation(tableID)) .
        DeliveryBox(tableID, Closed, Open, true, Normal);

    KitchenLoader(
        orders: OrderID -> OrderEntry,
        unassigned: FSet(OrderID),
        posOneOccupied: PosOneOccupied,
        skipped: Bool,
        mode: SystemMode
    ) =
        sum oid: OrderID, entry: OrderEntry .
            (oid < maxOrders) ->
                ReceiveOrder(oid, entry) .
                KitchenLoader(
                    orders[oid -> entry],
                    unassigned + {oid},
                    posOneOccupied,
                    skipped,
                    mode
                )

        + (mode == Normal && skipped) ->
            (sum inSlot: PlateSlot .
                ReceivesLoadingPosition(inSlot) . CheckPosOne .
                KitchenLoader(posOneOccupied = inSlot != Empty, skipped = false))

        + (mode == Normal && !skipped && (posOneOccupied || unassigned == {})) ->
            SendSkip(Kitchen) . SendStationDone(Kitchen) .
            KitchenLoader(skipped = true)

        + sum oid: OrderID .
            (mode == Normal && oid in unassigned && !posOneOccupied &&
             !skipped && oid < maxOrders) ->
                AddPlate(oid, t(orders(oid))) .
                (LoadPlate(oid) | OffersLoadingPlate(plate(oid, t(orders(oid))))) .
                SendStationDone(Kitchen) .
                KitchenLoader(orders, unassigned - {oid}, posOneOccupied, true, mode)

        + (mode == Normal && skipped) ->
            ReceivesEmergency(Kitchen) . StopLoading .
            KitchenLoader(mode = Emergency)

        + (mode == Emergency) ->
            ReceivesClearEmergency(Kitchen) .
            KitchenLoader(mode = Normal);

    System =
        % Block unmatched endpoints so only paired communications can occur.
        block(
            {ConveyorMovedNewPosition, ReceivesConveyorPosition,
             SendOrder, ReceiveOrder,
             IssueEmergency, ReceivesEmergency,
             IssueClearEmergency, ReceivesClearEmergency,
             RequestRound, PermitRound,
             SendLoadingPosition, ReceivesLoadingPosition,
             OffersLoadingPlate, ReceivesLoadingPlate,
             OffersTransfer, ReceivesTransfer,
             SendStationDone, ReceivesStationDone},
            comm(
                {
                    ConveyorMovedNewPosition | ReceivesConveyorPosition -> ConveyorPosition,
                    IssueEmergency | ReceivesEmergency -> EmergencyReceived,
                    IssueClearEmergency | ReceivesClearEmergency -> EmergencyCleared,
                    RequestRound | PermitRound -> RoundPermitted,
                    SendLoadingPosition | ReceivesLoadingPosition -> LoadingPosition,
                    OffersLoadingPlate | ReceivesLoadingPlate -> PlateLoaded,
                    OffersTransfer | ReceivesTransfer -> PlateTransferred,
                    SendStationDone | ReceivesStationDone -> StationDone,
                    SendOrder | ReceiveOrder -> OrderToKitchen
                },
                OrderManager(
                    lambda id: OrderID . order(Doner, Table1),
                    0,
                    Normal,
                    false,
                    false,
                    {}
                )
                || ConveyorBelt(
                    0,
                    Normal,
                    [Empty, Empty, Empty, Empty, Empty, Empty],
                    {},
                    false
                )
                || KitchenLoader(
                    lambda oid: OrderID . order(Doner, Table1),
                    {},
                    false,
                    true,
                    Normal
                )
                || DeliveryBox(Table1, Open, Closed, false, Normal)
                || DeliveryBox(Table2, Open, Closed, false, Normal)
            )
        );

% Interleave independent actions, retaining the required synchronized actions.
% The controllers still run in parallel and may act in either order.
init allow(
    {
        AcceptOrder, AddPlate, StopLoading,
        StartEmergency, OperatorClearEmergency,
        StartConveyor, Advance, StopConveyor,
        OpenInnerGate, CloseInnerGate, OpenOuterGate, CloseOuterGate,
        Retract, OrderToKitchen, CheckPosOne, BoxEmptied, SendSkip, StationDone,
        LoadPlate | PlateLoaded,
        Push | BoxFilled | PlateTransferred,
        RequestPermission | RoundPermitted | LoadingPosition |
            ConveyorPosition | ConveyorPosition,
        EmergencyReceived | EmergencyReceived |
            EmergencyReceived | EmergencyReceived,
        EndEmergency | EmergencyCleared | EmergencyCleared |
            EmergencyCleared | EmergencyCleared
    },
    System
);
