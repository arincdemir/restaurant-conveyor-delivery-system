% F1: after each acceptance, that order can be prepared and loaded.
% Acceptance does not expose an ID, so nextID tracks acceptance order from 0.
% Existential reachability is intentional: emergencies need not be avoided
% on every execution. Empty-slot loading is checked separately by S6.
nu Orders(nextID: OrderID = 0) .
(
    forall meal: Meal, tbl: TableID .
        [AcceptOrder(meal, tbl)]
        (
            <true* . AddPlate(nextID, tbl) . true* .
             (LoadPlate(nextID) | PlateLoaded(plate(nextID, tbl)))> true
            && Orders(nextID + 1)
        )
    && [!(exists meal: Meal, tbl: TableID . AcceptOrder(meal, tbl))] Orders(nextID)
)
