% F5: after transfer, the inner gate must close before the outer gate opens.
% This is ordering safety; it does not on its own demand eventual opening.
forall tbl: TableID .
nu Gate(needsClosure: Bool = false) .
(
    [(exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))] Gate(true)
    && [CloseInnerGate(tbl)] Gate(false)
    && [OpenOuterGate(tbl)] val(!needsClosure)
    && [!((exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) || CloseInnerGate(tbl))]
        Gate(needsClosure)
)
