% Same guarantee; compact form.
nu Belt(s0: Bool = false, s1: Bool = false, s2: Bool = false,
        s3: Bool = false, s4: Bool = false, s5: Bool = false) .
( [(exists oid: OrderID, pl: Plate . (LoadPlate(oid) | PlateLoaded(pl)))]
        (val(!s0) && Belt(true, s1, s2, s3, s4, s5))
    && [(exists pl: Plate . (Push(Table1) | BoxFilled(Table1) | PlateTransferred(Table1, pl)))]
        Belt(s0, s1, false, s3, s4, s5)
    && [(exists pl: Plate . (Push(Table2) | BoxFilled(Table2) | PlateTransferred(Table2, pl)))]
        Belt(s0, s1, s2, s3, false, s5)
    && [(exists pos: Position . Advance(pos))] Belt(s5, s0, s1, s2, s3, s4)
    && [!((exists oid: OrderID, pl: Plate . (LoadPlate(oid) | PlateLoaded(pl))) || (exists tbl: TableID, pl: Plate
        . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) || (exists pos: Position . Advance(pos)))]
        Belt(s0, s1, s2, s3, s4, s5)
)
