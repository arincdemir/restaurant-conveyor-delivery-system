% S11: opening either gate requires the paired gate to be closed.
% Check the stronger interlock throughout operation, including emergency release.
% Initially every inner gate is open and every outer gate is closed.
forall tbl: TableID .
nu Gates(innerOpen: Bool = true, outerOpen: Bool = false) .
(
    [OpenInnerGate(tbl)]
        (val(!outerOpen) && Gates(true, outerOpen))
    && [CloseInnerGate(tbl)] Gates(false, outerOpen)
    && [OpenOuterGate(tbl)]
        (val(!innerOpen) && Gates(innerOpen, true))
    && [CloseOuterGate(tbl)] Gates(innerOpen, false)
    && [!(OpenInnerGate(tbl) || CloseInnerGate(tbl) ||
          OpenOuterGate(tbl) || CloseOuterGate(tbl))]
        Gates(innerOpen, outerOpen)
)
