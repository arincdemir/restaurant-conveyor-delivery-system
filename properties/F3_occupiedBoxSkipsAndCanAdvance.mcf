% F3: a matching plate facing an occupied box cannot transfer before collection.
% A skip followed by advancement without removing that plate remains possible.
% This is one-round circulation capability, not unconditional eternal movement.
% Belt removal is the atomic transfer event in the current model.
forall tbl: TableID .
nu Box(full: Bool = false) .
(
    [(exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))] Box(true)
    && [BoxEmptied(tbl)] Box(false)
    && [!((exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) || BoxEmptied(tbl))]
        Box(full)
    && forall oid: OrderID, k, other: PlateSlot . (val(oid < maxOrders) =>
        [(RequestPermission | RoundPermitted | LoadingPosition(k) |
         ConveyorPosition(Table1, if(tbl == Table1, Occupied(plate(oid, tbl)), other)) | ConveyorPosition(Table2,
             if(tbl == Table2, Occupied(plate(oid, tbl)), other)))]
        (val(full) =>
            ([(!BoxEmptied(tbl))* . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, plate(oid, tbl)))] false
            && <(!(BoxEmptied(tbl) || (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, plate(oid, tbl)))))* .
                SendSkip(TableStation(tbl)) .
                (!(Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, plate(oid, tbl))))* . (exists pos: Position .
                    Advance(pos))> true)))
)
