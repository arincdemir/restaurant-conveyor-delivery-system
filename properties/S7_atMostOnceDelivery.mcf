% S7: each order is delivered at most once, including across emergencies.
% Every Plate has exactly one OrderID field by its type.
% The bound check also rejects transfers with IDs outside the model bound.
nu Deliveries(delivered: FSet(OrderID) = {}) .
(
    forall tbl: TableID, pl: Plate .
        [(Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))]
        (val(o_id(pl) < maxOrders && !(o_id(pl) in delivered))
         && Deliveries(delivered + {o_id(pl)}))
    && [!(exists tbl: TableID, pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))]
        Deliveries(delivered)
)
