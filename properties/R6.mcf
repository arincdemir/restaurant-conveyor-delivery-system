% R6: A pusher may start only with the correct plate aligned, the belt stopped, the inner gate open, and the outer gate closed. It must retract before the inner gate closes.
% Scope: six belt positions, two tables, three total orders; atomic events.

% CHECK: alignment
% Remember one current aligned slot; a transfer must consume that same plate.
(
forall tbl: TableID .
nu Aligned(slot: PlateSlot = Empty) .
(
    forall k, a, b: PlateSlot . [(RequestPermission | RoundPermitted | LoadingPosition(k) | ConveyorPosition(Table1, a) | ConveyorPosition(Table2, b))]
        Aligned(if(tbl == Table1, a, b))
    && forall pl: Plate . [(Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))]
        (val(slot == Occupied(pl) && t_id(pl) == tbl) && Aligned(Empty))
    && [((exists pos: Position . Advance(pos)) || (EndEmergency | EmergencyCleared(ConveyorStation) | EmergencyCleared(Kitchen) | EmergencyCleared(TableStation(Table1)) | EmergencyCleared(TableStation(Table2))))] Aligned(Empty)
    && [!((exists k, a, b: PlateSlot . (RequestPermission | RoundPermitted | LoadingPosition(k) | ConveyorPosition(Table1, a) | ConveyorPosition(Table2, b))) || (exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) || (exists pos: Position . Advance(pos)) || (EndEmergency | EmergencyCleared(ConveyorStation) | EmergencyCleared(Kitchen) | EmergencyCleared(TableStation(Table1)) | EmergencyCleared(TableStation(Table2))))] Aligned(slot)
)
)
% END CHECK
&&
% CHECK: stopped
% Pushing is forbidden between belt movement and stopping.
(
[true* . (StartConveyor || (exists pos: Position . Advance(pos))) . (!StopConveyor)* . (exists tbl: TableID, pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))] false
)
% END CHECK
&&
% CHECK: inner-open
% The inner gate starts open; after closure it must reopen before pushing.
(
forall tbl: TableID .
[true* . CloseInnerGate(tbl) . (!OpenInnerGate(tbl))* . (exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))] false
)
% END CHECK
&&
% CHECK: outer-closed
% After outer opening, close it before pushing.
(
forall tbl: TableID .
[true* . OpenOuterGate(tbl) . (!CloseOuterGate(tbl))* . (exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))] false
)
% END CHECK
&&
% CHECK: retract
% After pushing, retract before closing the inner gate.
(
forall tbl: TableID .
[true* . (exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) . (!Retract(tbl))* . CloseInnerGate(tbl)] false
)
% END CHECK
