% F9: after every synchronized reset, an advance remains reachable.
[true* .
 (EndEmergency |
  EmergencyCleared(ConveyorStation) |
  EmergencyCleared(Kitchen) |
  EmergencyCleared(TableStation(Table1)) |
  EmergencyCleared(TableStation(Table2)))]
<true* . (exists pos: Position . Advance(pos))> true
