% F6: after collection, all maximal executions eventually close the outer gate.
% No new transfer is allowed before that closure, so the box is available.
% mu Close rules out both an infinite non-closing path and an intervening deadlock.
% During emergency this closure can wait until the synchronized reset.
forall tbl: TableID .
[true* . BoxEmptied(tbl)]
(
    mu Close .
    (
        <true> true
        && [!CloseOuterGate(tbl)] Close
    )
    && [(!CloseOuterGate(tbl))* . (exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl)))]
        false
)
