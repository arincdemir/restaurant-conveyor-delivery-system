% Same guarantee; compact form.
forall tbl: TableID .
[true* . (exists pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) . (!BoxEmptied(tbl))*]
forall oid: OrderID . (val(oid < maxOrders) =>
[(exists k, other: PlateSlot . (RequestPermission | RoundPermitted | LoadingPosition(k) |
         ConveyorPosition(Table1, if(tbl == Table1, Occupied(plate(oid, tbl)), other)) | ConveyorPosition(Table2,
             if(tbl == Table2, Occupied(plate(oid, tbl)), other))))]
(
    [(!BoxEmptied(tbl))* . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, plate(oid, tbl)))] false
            && <(!(BoxEmptied(tbl) || (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, plate(oid, tbl)))))* .
                SendSkip(TableStation(tbl)) .
                (!(Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, plate(oid, tbl))))* . (exists pos: Position .
                    Advance(pos))> true
))
