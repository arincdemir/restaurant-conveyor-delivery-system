% Same guarantee; compact form.
nu Boxes(full1: Bool = false, full2: Bool = false, outer1: Bool = false, outer2: Bool = false) .
(
    [(exists pl: Plate . (Push(Table1) | BoxFilled(Table1) | PlateTransferred(Table1, pl)))] Boxes(true, full2,
        outer1, outer2)
    && [(exists pl: Plate . (Push(Table2) | BoxFilled(Table2) | PlateTransferred(Table2, pl)))] Boxes(full1, true,
        outer1, outer2)
    && [(exists one, two: Plate . (Push(Table1) | BoxFilled(Table1) | PlateTransferred(Table1, one) |
              Push(Table2) | BoxFilled(Table2) | PlateTransferred(Table2, two)))] Boxes(true, true, outer1, outer2)
    && [BoxEmptied(Table1)] Boxes(false, full2, outer1, outer2)
    && [BoxEmptied(Table2)] Boxes(full1, false, outer1, outer2)
    && [OpenOuterGate(Table1)] Boxes(full1, full2, true, outer2)
    && [OpenOuterGate(Table2)] Boxes(full1, full2, outer1, true)
    && [CloseOuterGate(Table1)] Boxes(full1, full2, false, outer2)
    && [CloseOuterGate(Table2)] Boxes(full1, full2, outer1, false)
    && [!((exists tbl: TableID, pl: Plate . (Push(tbl) | BoxFilled(tbl) | PlateTransferred(tbl, pl))) || (exists
        one, two: Plate . (Push(Table1) | BoxFilled(Table1) | PlateTransferred(Table1, one) |
              Push(Table2) | BoxFilled(Table2) | PlateTransferred(Table2, two))) || (exists tbl: TableID .
          BoxEmptied(tbl) || OpenOuterGate(tbl) || CloseOuterGate(tbl)))] Boxes(full1, full2, outer1, outer2)
    && forall first, second: OrderID, k: PlateSlot .
        (val(first < maxOrders && second < maxOrders) =>
        [(RequestPermission | RoundPermitted | LoadingPosition(k) |
         ConveyorPosition(Table1, Occupied(plate(first, Table1))) | ConveyorPosition(Table2, Occupied(plate(second,
             Table2))))]
        (val(!full1 && !full2 && !outer1 && !outer2) =>
            <(!((exists pos: Position . Advance(pos)) || StartConveyor || StartEmergency))* . (Push(Table1) |
                BoxFilled(Table1) | PlateTransferred(Table1, plate(first, Table1)) |
              Push(Table2) | BoxFilled(Table2) | PlateTransferred(Table2, plate(second, Table2)))> true))
)
